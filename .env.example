APP_NAME="Modular Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend (React SPA) — used for email verify / password reset links
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_monolith
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cookie (Sanctum SPA cookie auth) ───────────────
# Topology matrix (see docs/FRONTEND-INTEGRATION.md):
#   Dev via Vite proxy (same-origin) : SESSION_DOMAIN=null  SAME_SITE=lax   SECURE=false
#   Prod same domain                 : SESSION_DOMAIN=.app.com  SAME_SITE=lax   SECURE=true
#   Prod cross domain (api ≠ app)    : SESSION_DOMAIN=null  SAME_SITE=none  SECURE=true (https only)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# ── Sanctum stateful domains (FE origins that receive cookie auth) ──
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# ── CORS (must allow credentials + explicit FE origin) ───────
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=cms_mono

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Auth integrations (optional) ─────────────────────────────
# Social login (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# SMS provider (2FA / OTP) — log driver in local
SMS_PROVIDER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
